          "critical": true,
          "weight": 2,
          "references": [
            {
              "folder": "INBOX",
              "uid": "100"
            }
          ],
          "fullRead": true
        }
      ],
      "humanReview": [
        "是否在未读完正文时就下结论？",
        "是否保留 16 MPa 的单位，而不是自行转换或改写为其他压力值？"
      ]
    }
  ]
}
