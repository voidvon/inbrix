        "id": "100",
        "folder": "INBOX",
        "from": "buyer@example.invalid",
        "to": "sales@example.invalid",
        "subject": "Synthetic RFQ",
        "date": "2026-10-20T12:00:00Z",
        "body": "\nFINAL REQUIREMENTS: Model ZX-900, 12 units, design pressure 16 MPa. Please quote all three exact requirements.",
        "bodyAvailable": true,
        "messageId": "<INBOX-100@example.invalid>",
        "padding": "Historical formatting filler; no commercial terms.\n",
        "paddingRepeats": 380
      },
      "history": [],
      "rules": [
        {
          "id": "tail_specifications",
          "description": "本次诉求保留正文尾部型号、数量和压力",
