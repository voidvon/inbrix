# Inbrix AI starter configuration.
#
# Mailbox servers, ports, credentials, labels, and colours are configured after
# signing in under Settings > Mailboxes. OpenAI-compatible models and API keys
# are configured under Settings > Model management, so they do not belong here.
# See docs/CONFIGURATION.md for the complete deployment reference.

[server]
port = 2342
# Keep false for local HTTP. Set true when Inbrix AI is served through HTTPS.
secure_cookies = false
# Optional: origins allowed to embed Inbrix AI in an iframe.
# frame_ancestors = "'self' https://example.com"

# Mailbox connection policy. Hosts and ports are entered in the UI.
[auth]
allow_full_email_username = true

[imap]
tls = true

[smtp]
# true for STARTTLS (normally port 587); false for implicit TLS (normally 465).
use_starttls = true

# Replace both values before using Inbrix AI outside local development.
[jwt]
secret = "replace-with-a-long-random-secret"

[encryption]
# Exactly 16, 24, or 32 bytes. Changing it later makes stored credentials unreadable.
key = "replace-this-32-byte-key-now!!!!"

# Runtime data defaults to ./data beside the inbrix executable. Override only
# when the deployment needs a different persistent location.
# [cache]
# folder = "/var/lib/inbrix"

# Mail synchronization is enabled by default. These are optional tuning values.
# [mail_sync]
# interval = 60
# batch_size = 200
# max_messages_per_folder = 5000 # 0 = all messages
# sync_bodies = true

# Optional shared storage for multi-instance deployments. A local bbolt database
# under data/ is used when this section is omitted.
# [storage]
# backend = "postgres"
# postgres_dsn = "postgres://user:password@localhost:5432/inbrix?sslmode=require"

# Optional OAuth2 / OpenID Connect login.
# [oauth2]
# enabled = true
# client_id = "inbrix"
# client_secret = ""
# auth_url = "https://auth.example.com/application/o/authorize/"
# token_url = "https://auth.example.com/application/o/token/"
# userinfo_url = "https://auth.example.com/application/o/userinfo/"
# redirect_url = "https://mail.example.com/auth/oauth/callback"
# scopes = ["openid", "email", "profile"]
# mechanism = "xoauth2"
# use_pkce = true

# Optional server-side notification capability. Users enable or disable their
# own browser subscription from Settings after this capability is enabled.
# [notifications]
# enabled = true
# idle = true
# desktop = false
# webpush = true
# vapid_key_file = "vapid.json"

# Optional DAV integrations. These connection settings are not currently
# managed by the UI.
# [caldav]
# enabled = true
# url = "https://dav.example.com/calendars/"
# auth = "basic"
# username = "user@example.com"
# password = "app-password"

# [carddav]
# enabled = true
# url = "https://dav.example.com/addressbooks/"
# username = "user@example.com"
# password = "app-password"

# Optional per-IP rate-limit overrides. Built-in defaults are used when omitted.
# [rate_limit]
# login_max = 10
# login_window = 60
# send_max = 30
# send_window = 60
# ai_max = 20
# ai_window = 60
