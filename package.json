{
  "name": "lilmail-client-js",
  "version": "0.0.0",
  "private": true,
  "description": "Lilmail's React/Vite frontend and static browser tooling.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "dev:backend": "go run main.go -port 3001",
    "dev:all": "bash scripts/dev.sh",
    "build": "tsc -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "postbuild": "node scripts/ensure-dist-placeholder.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.sw.json && tsc -p frontend/tsconfig.json",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/serviceworker": "^0.0.200",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tiptap/core": "^3.30.0",
    "@tiptap/extension-image": "3.30.0",
    "@tiptap/extension-link": "^3.30.0",
    "@tiptap/extension-paragraph": "3.30.0",
    "@tiptap/extension-placeholder": "^3.30.0",
    "@tiptap/extension-underline": "^3.30.0",
    "@tiptap/react": "^3.30.0",
    "@tiptap/starter-kit": "^3.30.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  }
}
